-
-    while (p.type !== 'brace' && p.type !== 'root' && p.parent) {
-      p = p.parent;
-      q = p.queue;
-    }
+    const q = queueOwner(parent).queue;
 
     if (node.invalid || node.dollar) {
       q.push(append(q.pop(), stringify(node, options)));
@@ -77,13 +85,7 @@ const expand = (ast, options = {}) => {
     }
 
