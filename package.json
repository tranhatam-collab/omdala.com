{
  "name": "omdala.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "dev": "pnpm run dev:web",
    "start": "pnpm run start:web",
    "build": "pnpm run build:web",
    "dev:web": "pnpm --filter @omdala/web run dev",
    "start:web": "pnpm --filter @omdala/web run start",
    "build:web": "pnpm --filter @omdala/web run build",
    "dev:app": "pnpm --filter @omdala/app run dev",
    "start:app": "pnpm --filter @omdala/app run start",
    "build:app": "pnpm --filter @omdala/app run build",
    "omcode": "bash scripts/omcode-launch.sh",
    "dev:api": "pnpm --filter @omdala/api run dev",
    "start:api": "pnpm --filter @omdala/api run start",
    "build:api": "pnpm --filter @omdala/api run check",
    "lint": "eslint apps/web apps/app apps/admin apps/auth apps/docs packages services --max-warnings=0",
    "security:audit": "pnpm audit --prod --audit-level=high && pnpm audit --dev --audit-level=high",
    "e2e:app": "pnpm --filter @omdala/app exec playwright test",
    "e2e:web": "pnpm --filter @omdala/app exec playwright test --config ../../apps/web/playwright.config.ts",
    "e2e:brand-exchange": "pnpm --filter @omdala/brand-marketplace run test:e2e",
    "e2e:staging": "pnpm --filter @omdala/app exec playwright test --config playwright.staging.config.ts",
    "brand:lint": "bash scripts/brand-lint-omdala.sh apps/web/app",
    "brand:lint:static": "bash scripts/brand-lint-omdala.sh .",
    "dev:static": "node scripts/dev-server.mjs",
    "start:static": "node scripts/dev-server.mjs",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/dev-server.mjs --root dist --port 4174",
    "typecheck": "pnpm --filter @omdala/core typecheck && pnpm --filter @omdala/seo typecheck && pnpm --filter @omdala/types typecheck && pnpm --filter @omdala/ui typecheck",
    "test:api": "pnpm --filter @omdala/api test",
    "test:app": "pnpm --filter @omdala/app test",
    "test:core": "pnpm --filter @omdala/core test",
    "test:d1": "pnpm --filter @omdala/core test -- tenant-isolation",
    "release:verify": "node scripts/release-verify.mjs",
    "infra:audit:source": "node scripts/infra-readonly-probe.mjs",
    "infra:audit:remote": "node scripts/infra-readonly-probe.mjs --remote --confirm-read-only-remote",
    "test:brand-core": "pnpm --filter @omdala/brand-core run test",
    "build:all": "pnpm run build:web && pnpm --filter @omdala/app run build && pnpm --filter @omdala/docs run build && pnpm --filter @omdala/admin run build && pnpm --filter @omdala/auth run build"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12"
  },
  "pnpm": {
    "overrides": {
      "app-builder-lib": "26.15.3",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "builder-util-runtime": "9.7.0",
      "dmg-builder": "26.15.3",
      "electron-builder-squirrel-windows": "26.15.3",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "tar": "7.5.21",
      "undici": "7.29.0",
      "vite": "8.0.16",
      "ws": "8.21.0"
    }
  }
}
