# OMDALA Infra — Caddyfile
# Site names follow INFRA_DOMAIN. TLS and proxy mode require staging readback.

{
	admin off
	auto_https off
	log {
		output stdout
		format json
	}
}

# Health endpoint for Caddy itself
:80 {
	route /health {
		respond "OK" 200
	}
}

# Main infra domain
{$INFRA_DOMAIN} {
	route /health {
		respond "OMDALA Infra OK" 200
	}

	reverse_proxy /* api-gateway:3000
}

# API Gateway
api.{$INFRA_DOMAIN} {
	route /health {
		reverse_proxy api-gateway:3000
	}

	reverse_proxy /* api-gateway:3000
}

# Keycloak Auth
auth.{$INFRA_DOMAIN} {
	reverse_proxy /* keycloak:8080
}

# Monitoring (protected by basic auth + IP whitelist in production)
monitor.{$INFRA_DOMAIN} {
	reverse_proxy /* uptime-kuma:3001
}

