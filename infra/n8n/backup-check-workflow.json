{
  "name": "OMDALA Backup Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "hours", "hoursInterval": 24}]
        }
      },
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.omdala.com/health/deep",
        "options": {}
      },
      "name": "Check API Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "degraded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Degraded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "🚨 OMDALA Backup Check FAILED\nService: {{ $json.services.postgresql.status }}\nRedis: {{ $json.services.valkey.status }}\nR2: {{ $json.services.r2.status }}\nTimestamp: {{ $json.timestamp }}"
      },
      "name": "Alert Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [850, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "method": "POST",
        "body": {
          "text": "OMDALA Backup Check alert — see Telegram for details"
        },
        "options": {}
      },
      "name": "Alert Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Daily Trigger": { "main": [[{"node": "Check API Health", "type": "main", "index": 0}]] },
    "Check API Health": { "main": [[{"node": "Degraded?", "type": "main", "index": 0}]] },
    "Degraded?": {
      "main": [
        [{"node": "Alert Telegram", "type": "main", "index": 0}],
        [{"node": "Alert Webhook", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{"name": "omdala", "id": "omdala"}]
}
