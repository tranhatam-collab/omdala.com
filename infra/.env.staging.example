# OMDALA Infra — Staging Environment Template
# Copy to .env.staging and fill in real values. NEVER commit .env.staging to git.

INFRA_DOMAIN=staging.infra.omdala.com
ACME_EMAIL=admin@omdala.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_password_change_me
POSTGRES_DB=omdala_staging
POSTGRES_APP_USER=omdala_app
POSTGRES_APP_PASSWORD=staging_password_change_me
POSTGRES_READONLY_PASSWORD=staging_password_change_me
POSTGRES_MIGRATION_PASSWORD=staging_password_change_me
POSTGRES_BACKUP_PASSWORD=staging_password_change_me
POSTGRES_BACKUP_USER=omdala_backup
POSTGRES_MCP_PASSWORD=staging_password_change_me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=staging_password_change_me

R2_ACCESS_KEY_ID=<from_vault>
R2_SECRET_ACCESS_KEY=<from_vault>
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_BACKUPS=omdala-staging-backups

VALKEY_PASSWORD=staging_password_change_me

API_PORT=3000
API_JWT_PUBLIC_KEY_URL=https://auth.staging.infra.omdala.com/realms/OMDALA/protocol/openid-connect/certs
API_RATE_LIMIT=200
API_RATE_LIMIT_WINDOW_MS=60000

BACKUP_RETENTION_DAYS=7
WALG_S3_PREFIX=s3://omdala-staging-backups/postgres

WORKER_CONCURRENCY=3

# Scoped staging mail sink. No live recipient delivery before provider receipt.
EMAIL_API_URL=https://<approved_staging_mail_sink>/api/send
EMAIL_API_KEY=<from_staging_secret_store>
EMAIL_FROM=<approved_staging_sender>
EMAIL_STAGING_SINK_ADDRESS=<approved_staging_sink_address>

# Exact staging AIAGENT provider/ledger identity and trust keys.
AIAGENT_ENVIRONMENT=staging
AIAGENT_API_KEY=<from_staging_secret_store>
AIAGENT_EXPECTED_PROVIDER_SHA=<40_hex_candidate_sha>
AIAGENT_EXPECTED_PROVIDER_VERSION_ID=<staging_provider_version_id>
AIAGENT_EXPECTED_PROVIDER_BUNDLE_SHA256=<64_hex_bundle_digest>
AIAGENT_EXPECTED_LEDGER_SHA=<40_hex_candidate_sha>
AIAGENT_EXPECTED_LEDGER_VERSION_ID=<staging_ledger_version_id>
AIAGENT_EXPECTED_LEDGER_BUNDLE_SHA256=<64_hex_bundle_digest>
AIAGENT_EXPECTED_LEDGER_MIGRATION_SHA256=<64_hex_migration_digest>
AIAGENT_RECEIPT_PUBLIC_KEYS=<staging_keyring_json>

ALERT_WEBHOOK_URL=https://<approved_staging_alert_sink>
