# OMDALA Infra — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.

# ------------------------------------------------------------------
# Domain & SSL
# ------------------------------------------------------------------
INFRA_DOMAIN=infra.omdala.com
ACME_EMAIL=admin@omdala.com

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<from_vault>
POSTGRES_DB=omdala_prod
POSTGRES_APP_USER=omdala_app
POSTGRES_APP_PASSWORD=<from_vault>
POSTGRES_READONLY_USER=omdala_readonly
POSTGRES_READONLY_PASSWORD=<from_vault>
POSTGRES_MIGRATION_USER=omdala_migration
POSTGRES_MIGRATION_PASSWORD=<from_vault>
POSTGRES_BACKUP_USER=omdala_backup
POSTGRES_BACKUP_PASSWORD=<from_vault>
POSTGRES_MCP_USER=mcp_readonly
POSTGRES_MCP_PASSWORD=<from_vault>

# ------------------------------------------------------------------
# Keycloak
# ------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<from_vault>
KEYCLOAK_REALM=OMDALA
KEYCLOAK_FRONTEND_URL=https://auth.infra.omdala.com

# ------------------------------------------------------------------
# Object Storage (R2)
# ------------------------------------------------------------------
R2_ACCESS_KEY_ID=<from_vault>
R2_SECRET_ACCESS_KEY=<from_vault>
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_ASSETS=omdala-prod-assets
R2_BUCKET_USER_FILES=omdala-prod-user-files
R2_BUCKET_BACKUPS=omdala-prod-backups
R2_BUCKET_PRIVATE=omdala-prod-private

# ------------------------------------------------------------------
# MinIO (warm cache / internal S3)
# ------------------------------------------------------------------
MINIO_ROOT_USER=<from_vault>
MINIO_ROOT_PASSWORD=<from_vault>
MINIO_ENDPOINT=http://storage:9000

# ------------------------------------------------------------------
# Valkey / Redis
# ------------------------------------------------------------------
VALKEY_PASSWORD=<from_vault>

# ------------------------------------------------------------------
# Monitoring
# ------------------------------------------------------------------
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=<from_vault>
GRAFANA_ADMIN_PASSWORD=<from_vault>

# ------------------------------------------------------------------
# Vault
# ------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=<from_vault>

# ------------------------------------------------------------------
# API Gateway
# ------------------------------------------------------------------
API_PORT=3000
API_JWT_PUBLIC_KEY_URL=https://auth.infra.omdala.com/realms/OMDALA/protocol/openid-connect/certs
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------
# Backup
# ------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
WALG_S3_PREFIX=s3://omdala-prod-backups/postgres

# ------------------------------------------------------------------
# Notifications
# ------------------------------------------------------------------
ALERT_WEBHOOK_URL=<from_vault>
ALERT_EMAIL=admin@omdala.com
