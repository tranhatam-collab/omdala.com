{
  "dashboard": {
    "title": "OMDALA Infrastructure Overview",
    "tags": ["omdala", "infra"],
    "timezone": "UTC",
    "panels": [
      {
        "title": "API Health",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"api-gateway\"}",
            "legendFormat": "API Gateway"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
      },
      {
        "title": "API Latency (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(api_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 latency"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
        "yaxes": [
          { "label": "seconds", "min": 0, "max": 1 }
        ]
      },
      {
        "title": "PostgreSQL Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_activity_count{datname=\"omdala_prod\"}",
            "legendFormat": "Active connections"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
      },
      {
        "title": "Worker Queue Depth",
        "type": "graph",
        "targets": [
          {
            "expr": "bullmq_queue_count{queue=\"omdala-queue\"}",
            "legendFormat": "Jobs in queue"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "title": "AI Cost (USD/hour)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(model_usage_cost_usd[1h])) by (tenant_id)",
            "legendFormat": "{{tenant_id}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "title": "Disk Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
            "legendFormat": "Disk used %"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 85 }
          ]
        }
      },
      {
        "title": "Backup Status",
        "type": "stat",
        "targets": [
          {
            "expr": "backup_last_success_timestamp",
            "legendFormat": "Last backup"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 }
      },
      {
        "title": "Failed Jobs (last hour)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(bullmq_job_failed_count[1h])",
            "legendFormat": "Failed jobs"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 }
      },
      {
        "title": "Approval Requests Pending",
        "type": "stat",
        "targets": [
          {
            "expr": "approval_requests_pending_count",
            "legendFormat": "Pending approvals"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 36
  }
}
